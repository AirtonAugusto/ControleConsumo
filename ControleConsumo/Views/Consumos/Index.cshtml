@model IEnumerable<ControleConsumo.Models.Consumo>

@{
    ViewData["Title"] = "Consumos";
}

<h1>Consumos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo consumo</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Veículo</th>
            <th>@Html.DisplayNameFor(m => m.Descricao)</th>
            <th>@Html.DisplayNameFor(m => m.Data)</th>
            <th>@Html.DisplayNameFor(m => m.Valor)</th>
            <th>@Html.DisplayNameFor(m => m.Km)</th>
            <th>@Html.DisplayNameFor(m => m.Tipo)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Veiculo?.Nome</td>
                <td>@item.Descricao</td>
                <td>@item.Data.ToString("dd/MM/yyyy")</td>
                <td>@item.Valor.ToString("C")</td>
                <td>@item.Km</td>
                <td>@item.Tipo</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>