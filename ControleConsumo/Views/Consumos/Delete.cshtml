@model ControleConsumo.Models.Consumo

@{
    ViewData["Title"] = "Excluir consumo";
}

<h1>Excluir consumo</h1>
<h4 class="text-danger">Tem certeza que deseja excluir este consumo?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-3">Veículo</dt>
    <dd class="col-sm-9">@Model.Veiculo?.Nome</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Descricao)</dt>
    <dd class="col-sm-9">@Model.Descricao</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Data)</dt>
    <dd class="col-sm-9">@Model.Data.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Valor)</dt>
    <dd class="col-sm-9">@Model.Valor.ToString("C")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Km)</dt>
    <dd class="col-sm-9">@Model.Km</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Tipo)</dt>
    <dd class="col-sm-9">@Model.Tipo</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Excluir" class="btn btn-danger" /> |
    <a asp-action="Index">Voltar para a lista</a>
</form>
