@model IEnumerable<ControleConsumo.Models.Veiculo>

@{
    ViewData["Title"] = "Veículos";
}

<h1>Veículos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo veículo</a>
</p>

@if (!Model.Any())
{
    <p>Nenhum veículo cadastrado ainda.</p>
}
else
{
    <p class="text-muted">Clique no nome do veículo para ver o relatório de consumo.</p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.Nome)</th>
                <th>@Html.DisplayNameFor(m => m.Placa)</th>
                <th>@Html.DisplayNameFor(m => m.AnoFabricacao)</th>
                <th>@Html.DisplayNameFor(m => m.AnoModelo)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><a asp-action="Relatorio" asp-route-id="@item.Id">@item.Nome</a></td>
                    <td>@item.Placa</td>
                    <td>@item.AnoFabricacao</td>
                    <td>@item.AnoModelo</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
