@model ControleConsumo.Models.Veiculo

@{
    ViewData["Title"] = "Excluir veículo";
}

<h1>Excluir veículo</h1>
<h4 class="text-danger">Tem certeza que deseja excluir este veículo?</h4>
<p class="text-muted">Atenção: os consumos deste veículo também serão excluídos.</p>
<hr />
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nome)</dt>
    <dd class="col-sm-9">@Model.Nome</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Placa)</dt>
    <dd class="col-sm-9">@Model.Placa</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.AnoFabricacao)</dt>
    <dd class="col-sm-9">@Model.AnoFabricacao</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.AnoModelo)</dt>
    <dd class="col-sm-9">@Model.AnoModelo</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Excluir" class="btn btn-danger" /> |
    <a asp-action="Index">Voltar para a lista</a>
</form>
