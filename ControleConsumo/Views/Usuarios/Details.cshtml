@model ControleConsumo.Models.Usuario

@{
    ViewData["Title"] = "Detalhes do usuário";
}

<h1>Detalhes do usuário</h1>
<hr />
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nome)</dt>
    <dd class="col-sm-9">@Model.Nome</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Perfil)</dt>
    <dd class="col-sm-9">@Model.Perfil</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a> |
    <a asp-action="Index">Voltar para a lista</a>
</div>
